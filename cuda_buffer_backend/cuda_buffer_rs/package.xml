<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>cuda_buffer_rs</name>
  <version>0.1.0</version>
  <description>Rust bindings for the CUDA-backed rosidl::Buffer C ABI, providing raw
  FFI declarations and RAII read/write guards over opaque buffer pointers.</description>

  <maintainer email="yuankunz@nvidia.com">Yuankun Zhu</maintainer>
  <license>Apache-2.0</license>
  <author email="yuankunz@nvidia.com">Yuankun Zhu</author>

  <depend>cuda_buffer</depend>
  <depend>cuda_buffer_backend</depend>
  <depend>rosidl_buffer</depend>
  <depend>rosidl_runtime_rs</depend>

  <test_depend>rclrs</test_depend>
  <test_depend>std_msgs</test_depend>

  <export>
    <build_type>ament_cargo</build_type>
  </export>
</package>
