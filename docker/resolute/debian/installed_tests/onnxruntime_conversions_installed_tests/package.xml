<?xml version="1.0"?>
<package format="3">
  <name>onnxruntime_conversions_installed_tests</name>
  <version>0.1.2</version>
  <description>Source-only tests compiled against installed ONNX Runtime conversion Debians.</description>
  <maintainer email="yuankunz@nvidia.com">Yuankun Zhu</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>ament_cmake_gtest</depend>
  <depend>launch_testing_ament_cmake</depend>
  <depend version_gte="12" version_lt="13">nvidia-cuda</depend>
  <depend>onnxruntime_conversions</depend>
  <depend>onnxruntime_conversions_cpu</depend>
  <depend>onnxruntime_conversions_cuda</depend>
  <depend>onnxruntime_cuda_vendor</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>rosidl_runtime_cpp</depend>
  <depend>std_msgs</depend>
  <depend>tensor_msgs</depend>
  <exec_depend>onnxruntime_conversions_py</exec_depend>
  <exec_depend>onnxruntime_conversions_py_cpu</exec_depend>
  <exec_depend>onnxruntime_conversions_py_cuda</exec_depend>
  <exec_depend>python3-pytest</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rmw_fastrtps_cpp</exec_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
