# syntax=docker/dockerfile:1

ARG ROS_IMAGE=ros:rolling-ros-base-resolute
FROM ${ROS_IMAGE} AS buildbase

ARG UBUNTU_MIRROR=https://mirrors.edge.kernel.org/ubuntu

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ENV DEBIAN_FRONTEND=noninteractive \
    ROS_DISTRO=rolling \
    CMAKE_BUILD_PARALLEL_LEVEL=2

# Assert the starting image has none of the accelerator/framework inputs. The
# package manifests and rosdep must introduce every build dependency afterward.
RUN ! command -v nvcc && \
    ! python3 -c 'import torch' 2>/dev/null && \
    ! command -v nvidia-smi && \
    [[ ! -e /dev/nvidiactl ]] && \
    ! ldconfig -p | grep -E 'libtorch|libcudart'

RUN sed -i \
      -e "s|http://archive.ubuntu.com/ubuntu|${UBUNTU_MIRROR}|g" \
      -e "s|http://security.ubuntu.com/ubuntu|${UBUNTU_MIRROR}|g" \
      /etc/apt/sources.list.d/ubuntu.sources && \
    sed -i 's|http://packages.ros.org/ros2-testing/ubuntu|https://ftp.osuosl.org/pub/ros2-testing|g' \
      /etc/apt/sources.list.d/ros2.sources && \
    printf 'Acquire::Retries "5";\nAcquire::https::Timeout "60";\n' \
      > /etc/apt/apt.conf.d/80-rosidl-build-retries

RUN apt-get update && \
    apt-get install --no-install-recommends -y \
      build-essential \
      debhelper \
      dpkg-dev \
      fakeroot \
      python3-bloom \
      python3-rosdep && \
    rm -rf /var/lib/apt/lists/*

# Keep packages fetched by rosdep so the validation container can consume an
# offline apt repository and prove exactly which dependencies were introduced.
RUN rm -f /etc/apt/apt.conf.d/docker-clean && \
    printf 'Binary::apt::APT::Keep-Downloaded-Packages "true";\nAPT::Install-Recommends "false";\n' \
      > /etc/apt/apt.conf.d/80-rosidl-keep-debians

RUN rosdep update --rosdistro "${ROS_DISTRO}"

FROM buildbase AS builder

WORKDIR /source/rosidl_buffer_backends
COPY . .

RUN bash docker/resolute/debian/build-debians.sh \
    /source/rosidl_buffer_backends /artifacts

FROM scratch AS debians
COPY --from=builder /artifacts/ /
