<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>onnxruntime_conversions_py</name>
  <version>0.1.2</version>
  <description>Python adapter between ONNX Runtime OrtValue and DLPack tensor messages.</description>

  <maintainer email="yuankunz@nvidia.com">Yuankun Zhu</maintainer>
  <license>Apache-2.0</license>
  <author email="yuankunz@nvidia.com">Yuankun Zhu</author>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <exec_depend>dlpack_conversions_py</exec_depend>
  <exec_depend>dlpack_conversions_py_cpu</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>tensor_msgs</exec_depend>

  <!-- No wheel provider is named. Every provider conflicts with the others,
       so depending on one would stop apt swapping it for another without
       removing this package, which is the CPU to GPU upgrade. bloom emits no
       Provides, so no virtual package can bridge them either. -->
  <test_depend>python_onnxruntime_vendor</test_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>cuda_buffer_py</test_depend>
  <test_depend>dlpack_conversions_py_cuda</test_depend>
  <test_depend>rclpy</test_depend>
  <test_depend>rmw_fastrtps_cpp</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
