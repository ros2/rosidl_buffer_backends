<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>onnxruntime_conversions_py_cuda</name>
  <version>0.1.2</version>
  <description>CUDA runtime dependencies for Python ONNX Runtime conversions.</description>

  <maintainer email="yuankunz@nvidia.com">Yuankun Zhu</maintainer>
  <license>Apache-2.0</license>
  <author email="yuankunz@nvidia.com">Yuankun Zhu</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>cuda_buffer_backend</exec_depend>
  <exec_depend>cuda_buffer_py</exec_depend>
  <exec_depend>onnxruntime_conversions_py_core</exec_depend>
  <exec_depend>python_onnxruntime_cuda_vendor</exec_depend>

  <conflict>onnxruntime_conversions_py_cpu</conflict>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>launch_testing</test_depend>
  <test_depend>python3-onnx</test_depend>
  <test_depend>rclpy</test_depend>
  <test_depend>rmw_fastrtps_cpp</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
