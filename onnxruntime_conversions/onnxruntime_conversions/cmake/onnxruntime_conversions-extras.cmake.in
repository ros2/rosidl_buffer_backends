include(CMakeFindDependencyMacro)
find_dependency(onnxruntime_core_vendor)
if(NOT ONNXRUNTIME_CORE_VENDOR_SELECTED_VERSION STREQUAL "@ONNXRUNTIME_CORE_VENDOR_SELECTED_VERSION@")
  message(FATAL_ERROR "onnxruntime_conversions was built with ONNX Runtime @ONNXRUNTIME_CORE_VENDOR_SELECTED_VERSION@, "
    "but the selected provider is ${ONNXRUNTIME_CORE_VENDOR_SELECTED_VERSION}. Rebuild the native conversions "
    "and their consumers against the selected provider.")
endif()
