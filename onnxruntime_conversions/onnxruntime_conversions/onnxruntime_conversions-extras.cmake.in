if(ONNXRUNTIME_GPU_VENDOR_HAS_CUDA)
  find_package(CUDAToolkit QUIET)
  find_package(cuda_buffer QUIET)

  if(CUDAToolkit_FOUND AND cuda_buffer_FOUND AND
      TARGET CUDA::cudart AND TARGET cuda_buffer::cuda_buffer)
    set(_onnxruntime_conversions_exported_targets
      ${onnxruntime_conversions_TARGETS}
      onnxruntime_conversions::onnxruntime_conversions)
    list(REMOVE_DUPLICATES _onnxruntime_conversions_exported_targets)

    foreach(_onnxruntime_conversions_target
        IN LISTS _onnxruntime_conversions_exported_targets)
      if(TARGET "${_onnxruntime_conversions_target}")
        get_target_property(
          _onnxruntime_conversions_cuda_configured
          "${_onnxruntime_conversions_target}"
          ONNXRUNTIME_CONVERSIONS_CUDA_CONFIGURED)
        if(NOT _onnxruntime_conversions_cuda_configured)
          set_property(
            TARGET "${_onnxruntime_conversions_target}"
            APPEND PROPERTY INTERFACE_COMPILE_DEFINITIONS
              ONNXRUNTIME_CONVERSIONS_HAS_CUDA)
          set_property(
            TARGET "${_onnxruntime_conversions_target}"
            APPEND PROPERTY INTERFACE_LINK_LIBRARIES
              cuda_buffer::cuda_buffer CUDA::cuda_driver CUDA::cudart)
          set_property(
            TARGET "${_onnxruntime_conversions_target}"
            PROPERTY ONNXRUNTIME_CONVERSIONS_CUDA_CONFIGURED TRUE)
        endif()
      endif()
    endforeach()

    unset(_onnxruntime_conversions_cuda_configured)
    unset(_onnxruntime_conversions_exported_targets)
    unset(_onnxruntime_conversions_target)
  endif()
endif()
