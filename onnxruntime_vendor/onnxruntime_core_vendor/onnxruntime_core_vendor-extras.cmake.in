set(onnxruntime_core_vendor_VERSION "@ONNXRUNTIME_CORE_VENDOR_VERSION@")
set(ONNXRUNTIME_CORE_VENDOR_VERSION "@ONNXRUNTIME_CORE_VENDOR_VERSION@")
set(ONNXRUNTIME_CORE_VENDOR_VARIANT "@ONNXRUNTIME_CORE_VENDOR_VARIANT@")
set(ONNXRUNTIME_CORE_VENDOR_SHA256 "@ONNXRUNTIME_CORE_VENDOR_SHA256@")
set(ONNXRUNTIME_CORE_VENDOR_ARCHIVE_STEM
  "@ONNXRUNTIME_CORE_VENDOR_ARCHIVE_STEM@")
set(ONNXRUNTIME_CORE_VENDOR_ARCHIVE "@ONNXRUNTIME_CORE_VENDOR_ARCHIVE@")
set(ONNXRUNTIME_CORE_VENDOR_URL "@ONNXRUNTIME_CORE_VENDOR_URL@")

get_filename_component(
  _onnxruntime_core_vendor_prefix
  "${onnxruntime_core_vendor_DIR}/../../.."
  ABSOLUTE)
set(onnxruntime_core_vendor_ROOT
  "${_onnxruntime_core_vendor_prefix}/opt/onnxruntime_core_vendor")
set(onnxruntime_core_vendor_INCLUDE_DIRS
  "${onnxruntime_core_vendor_ROOT}/include")
set(onnxruntime_core_vendor_LIBRARY_DIRS
  "${onnxruntime_core_vendor_ROOT}/lib")

if(NOT TARGET onnxruntime::onnxruntime)
  add_library(onnxruntime::onnxruntime SHARED IMPORTED)
  set_target_properties(onnxruntime::onnxruntime PROPERTIES
    IMPORTED_LOCATION
      "${onnxruntime_core_vendor_LIBRARY_DIRS}/libonnxruntime.so"
    INTERFACE_INCLUDE_DIRECTORIES
      "${onnxruntime_core_vendor_INCLUDE_DIRS}"
    INTERFACE_LINK_OPTIONS
      "$<$<PLATFORM_ID:Linux>:LINKER:-rpath,${onnxruntime_core_vendor_LIBRARY_DIRS}>")
endif()

unset(_onnxruntime_core_vendor_prefix)
