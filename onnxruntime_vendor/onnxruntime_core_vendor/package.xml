<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>onnxruntime_core_vendor</name>
  <version>0.1.2</version>
  <description>ONNX Runtime 1.26.0 C++ SDK and core runtime.</description>

  <maintainer email="yuankunz@nvidia.com">Yuankun Zhu</maintainer>
  <license>Apache-2.0</license>
  <license>MIT</license>
  <author email="yuankunz@nvidia.com">Yuankun Zhu</author>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_vendor_package</buildtool_depend>

  <!-- Every provider of libonnxruntime.so.1 puts its own lib directory on
       LD_LIBRARY_PATH, so a consumer would be served by whichever comes
       first. Exactly one runtime may be installed. onnxruntime_cuda_vendor
       is the superset of this package and replaces it on GPU hosts.
       Ubuntu's libonnxruntime1.23 cannot be declared here because bloom
       resolves every conflict through rosdep and no key names it; its
       SONAME is version-qualified, so it does not collide anyway. -->
  <conflict>onnxruntime_cuda_vendor</conflict>
  <conflict>onnxruntime_vendor</conflict>

  <test_depend>ament_cmake_xmllint</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
