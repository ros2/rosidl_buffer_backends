<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>onnxruntime_cuda_vendor</name>
  <version>0.1.2</version>
  <description>ONNX Runtime 1.26.0 GPU C++ distribution for CUDA 12.</description>

  <maintainer email="yuankunz@nvidia.com">Yuankun Zhu</maintainer>
  <license>Apache-2.0</license>
  <license>MIT</license>
  <license>NVIDIA Software License Agreement</license>
  <author email="yuankunz@nvidia.com">Yuankun Zhu</author>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_vendor_package</buildtool_depend>

  <depend version_gte="12" version_lt="13">nvidia-cuda</depend>
  <depend version_gte="9" version_lt="10">nvidia-cudnn</depend>

  <!-- See onnxruntime_core_vendor: exactly one provider of
       libonnxruntime.so.1 may be installed. This package is its superset,
       adding libonnxruntime_providers_cuda.so. -->
  <conflict>onnxruntime_core_vendor</conflict>
  <conflict>onnxruntime_vendor</conflict>

  <test_depend>ament_cmake_xmllint</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
