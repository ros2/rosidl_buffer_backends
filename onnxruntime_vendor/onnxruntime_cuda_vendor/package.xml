<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>onnxruntime_cuda_vendor</name>
  <version>0.1.2</version>
  <description>ONNX Runtime GPU 1.23.2 C++ distribution for CUDA 12 and cuDNN 9.</description>

  <maintainer email="yuankunz@nvidia.com">Yuankun Zhu</maintainer>
  <license>Apache-2.0</license>
  <license>MIT</license>
  <author email="yuankunz@nvidia.com">Yuankun Zhu</author>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_vendor_package</buildtool_depend>

  <depend version_gte="12" version_lt="13">nvidia-cuda</depend>
  <exec_depend version_gte="9" version_lt="10">nvidia-cudnn</exec_depend>

  <conflict>libonnxruntime-dev</conflict>
  <conflict>onnxruntime_conversions_cpu</conflict>

  <test_depend>ament_cmake_xmllint</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
