<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>onnxruntime_cuda_vendor</name>
  <version>0.1.2</version>
  <description>ONNX Runtime GPU C++ distribution.</description>

  <maintainer email="yuankunz@nvidia.com">Yuankun Zhu</maintainer>
  <license>Apache-2.0</license>
  <license>MIT</license>
  <license>NVIDIA Software License Agreement</license>
  <author email="yuankunz@nvidia.com">Yuankun Zhu</author>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_vendor_package</buildtool_depend>

  <build_depend>python3-pip</build_depend>

  <depend version_gte="12" version_lt="13">nvidia-cuda</depend>
  <depend version_gte="9" version_lt="10">nvidia-cudnn</depend>

  <depend>onnxruntime_core_vendor</depend>
  <conflict>onnxruntime_vendor</conflict>

  <test_depend>ament_cmake_xmllint</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
