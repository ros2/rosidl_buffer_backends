<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>python_onnxruntime_cuda_vendor</name>
  <version>0.1.2</version>
  <description>ONNX Runtime 1.23.2 Python wheel for CUDA 12 and cuDNN 9.</description>

  <maintainer email="yuankunz@nvidia.com">Yuankun Zhu</maintainer>
  <license>Apache-2.0</license>
  <license>MIT</license>
  <author email="yuankunz@nvidia.com">Yuankun Zhu</author>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <build_depend>python3-pip</build_depend>

  <conflict>python3-onnxruntime</conflict>
  <conflict>onnxruntime_conversions_py_cpu</conflict>

  <depend version_gte="12" version_lt="13">nvidia-cuda</depend>
  <exec_depend version_gte="9" version_lt="10">nvidia-cudnn</exec_depend>
  <exec_depend>python3-flatbuffers</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-packaging</exec_depend>
  <exec_depend>python3-protobuf</exec_depend>
  <exec_depend>python3</exec_depend>

  <test_depend>ament_cmake_xmllint</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
