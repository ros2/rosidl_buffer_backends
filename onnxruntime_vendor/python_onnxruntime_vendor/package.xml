<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>python_onnxruntime_vendor</name>
  <version>0.1.2</version>
  <description>ONNX Runtime 1.26.0 CPU Python wheel.</description>

  <maintainer email="yuankunz@nvidia.com">Yuankun Zhu</maintainer>
  <license>Apache-2.0</license>
  <license>MIT</license>
  <author email="yuankunz@nvidia.com">Yuankun Zhu</author>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <build_depend>python3-pip</build_depend>

  <!-- Ubuntu's python3-onnxruntime installs the same top-level onnxruntime
       module, so whichever comes first on sys.path would win. Exactly one
       provider of the module may be installed. -->
  <conflict>python3-onnxruntime</conflict>
  <conflict>python_onnxruntime_cuda_vendor</conflict>

  <exec_depend>python3-flatbuffers</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-packaging</exec_depend>
  <exec_depend>python3-protobuf</exec_depend>
  <exec_depend>python3</exec_depend>

  <test_depend>ament_cmake_xmllint</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
