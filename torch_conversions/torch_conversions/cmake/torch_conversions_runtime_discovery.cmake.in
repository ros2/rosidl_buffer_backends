include("${ament_cmake_core_DIR}/index/ament_index_get_resource.cmake")
include("${ament_cmake_core_DIR}/index/ament_index_get_resources.cmake")

set(torch_conversions_Interface_FOUND TRUE)

if("Interface" IN_LIST torch_conversions_FIND_COMPONENTS)
  return()
endif()

ament_index_get_resources(
  _torch_conversions_runtimes
  "torch_conversions__runtime"
)
list(LENGTH _torch_conversions_runtimes _torch_conversions_runtime_count)
if(NOT _torch_conversions_runtime_count EQUAL 1)
  message(FATAL_ERROR
    "torch_conversions requires exactly one C++ runtime package, but found "
    "${_torch_conversions_runtime_count}: [${_torch_conversions_runtimes}]. "
    "Install/build exactly one of torch_conversions_cpu or "
    "torch_conversions_cuda, then reconfigure dependent packages.")
endif()

list(GET _torch_conversions_runtimes 0 _torch_conversions_runtime_package)
ament_index_get_resource(
  _torch_conversions_runtime_target
  "torch_conversions__runtime"
  "${_torch_conversions_runtime_package}"
)
string(STRIP "${_torch_conversions_runtime_target}"
  _torch_conversions_runtime_target)

find_package("${_torch_conversions_runtime_package}" CONFIG REQUIRED)
if(NOT TARGET "${_torch_conversions_runtime_target}")
  message(FATAL_ERROR
    "${_torch_conversions_runtime_package} registered missing target "
    "'${_torch_conversions_runtime_target}'")
endif()

target_link_libraries(
  torch_conversions::torch_conversions
  INTERFACE "${_torch_conversions_runtime_target}"
)

unset(_torch_conversions_runtime_count)
unset(_torch_conversions_runtime_package)
unset(_torch_conversions_runtime_target)
unset(_torch_conversions_runtimes)
