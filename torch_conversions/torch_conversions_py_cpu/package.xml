<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>torch_conversions_py_cpu</name>
  <version>0.1.2</version>
  <description>CPU runtime plugin for Python PyTorch tensor conversions.</description>

  <maintainer email="yuankunz@nvidia.com">Yuankun Zhu</maintainer>
  <license>Apache-2.0</license>
  <author email="yuankunz@nvidia.com">Yuankun Zhu</author>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <exec_depend version_gte="2.9.1" version_lt="2.10">python3-torch</exec_depend>
  <exec_depend>torch_conversions_py</exec_depend>

  <conflict>python3_torch_cuda_vendor</conflict>
  <conflict>torch_conversions_py_cuda</conflict>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
