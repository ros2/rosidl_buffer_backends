<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>dlpack_conversions</name>
  <version>0.1.0</version>
  <description>Framework-free DLPack conversions for tensor messages.</description>

  <maintainer email="yuankunz@nvidia.com">Yuankun Zhu</maintainer>
  <license>Apache-2.0</license>
  <author email="yuankunz@nvidia.com">Yuankun Zhu</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>pluginlib</depend>
  <depend>rcutils</depend>
  <depend>rmw</depend>
  <depend>rosidl_buffer</depend>
  <depend>tensor_msgs</depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>dlpack_conversions_cpu</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
