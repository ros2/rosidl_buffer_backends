set(onnxruntime_cuda_vendor_VERSION "@ONNXRUNTIME_VERSION@")
get_filename_component(
  _onnxruntime_cuda_vendor_prefix
  "${onnxruntime_cuda_vendor_DIR}/../../.."
  ABSOLUTE)
set(onnxruntime_cuda_vendor_ROOT
  "${_onnxruntime_cuda_vendor_prefix}/opt/onnxruntime_cuda_vendor")
set(onnxruntime_cuda_vendor_INCLUDE_DIRS
  "${onnxruntime_cuda_vendor_ROOT}/include")
set(onnxruntime_cuda_vendor_LIBRARY_DIRS
  "${onnxruntime_cuda_vendor_ROOT}/lib")

if(NOT TARGET onnxruntime_cuda::onnxruntime)
  add_library(onnxruntime_cuda::onnxruntime SHARED IMPORTED)
  set_target_properties(onnxruntime_cuda::onnxruntime PROPERTIES
    IMPORTED_LOCATION
      "${onnxruntime_cuda_vendor_LIBRARY_DIRS}/libonnxruntime.so"
    INTERFACE_INCLUDE_DIRECTORIES
      "${onnxruntime_cuda_vendor_INCLUDE_DIRS}"
    INTERFACE_LINK_OPTIONS
      "$<$<PLATFORM_ID:Linux>:LINKER:-rpath,${onnxruntime_cuda_vendor_LIBRARY_DIRS}>"
  )
endif()

unset(_onnxruntime_cuda_vendor_prefix)
