<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>intel_buffer_backend</name>
  <version>0.1.0</version>
  <description>Pluginlib backend for Intel USM-backed rosidl::Buffer transport,
  supporting zero-copy memory sharing via Level Zero USM and DMA-BUF across
  CPU, iGPU, IPU, and NPU on Intel Core Ultra 3 (Panther Lake).</description>

  <maintainer email="ramkumar.k@intel.com">Ramkumar K</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake_auto</buildtool_depend>

  <depend>intel_buffer</depend>
  <depend>intel_memory_core</depend>
  <depend>intel_buffer_backend_msgs</depend>
  <depend>pluginlib</depend>
  <depend>rcutils</depend>
  <depend>rosidl_buffer_backend</depend>
  <depend>rosidl_buffer_backend_registry</depend>
  <depend>rosidl_runtime_cpp</depend>
  <depend>rosidl_typesupport_cpp</depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>rmw</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
