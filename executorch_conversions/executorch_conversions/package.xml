<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>executorch_conversions</name>
  <version>0.1.2</version>
  <description>Runtime-pluggable conversions between ExecuTorch tensors and tensor messages.</description>

  <maintainer email="anthony@shoumikh.in">Anthony Shoumikhin</maintainer>
  <license>Apache-2.0</license>
  <author email="anthony@shoumikh.in">Anthony Shoumikhin</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>executorch_vendor</depend>
  <depend>pluginlib</depend>
  <depend>tensor_msgs</depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>rosidl_runtime_cpp</depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
