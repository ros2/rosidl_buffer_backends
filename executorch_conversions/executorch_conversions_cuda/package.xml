<?xml version="1.0"?>
<package format="3">
  <name>executorch_conversions_cuda</name>
  <version>0.1.2</version>
  <description>CUDA plugin for the ExecuTorch conversion registry.</description>
  <maintainer email="anthony@shoumikh.in">Anthony Shoumikhin</maintainer>
  <license>Apache-2.0</license>
  <author email="anthony@shoumikh.in">Anthony Shoumikhin</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>cuda_buffer</depend>
  <depend>cuda-toolkit</depend>
  <depend>executorch_conversions</depend>
  <depend>executorch_cuda_vendor</depend>
  <depend>pluginlib</depend>

  <exec_depend>cuda_buffer_backend</exec_depend>
  <!-- cuda_buffer can fall back to host memory, and those messages need the CPU plugin. -->
  <exec_depend>executorch_conversions_cpu</exec_depend>

  <test_depend>ament_cmake_cppcheck</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <test_depend>launch_testing_ament_cmake</test_depend>
  <test_depend>launch_testing</test_depend>
  <test_depend>launch_ros</test_depend>
  <test_depend>ament_cmake_ros</test_depend>
  <test_depend>rmw_fastrtps_cpp</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
