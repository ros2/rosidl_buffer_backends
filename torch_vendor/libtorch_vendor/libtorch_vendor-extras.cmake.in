set(LIBTORCH_VENDOR_VERSION "@LIBTORCH_VENDOR_VERSION@")
set(LIBTORCH_VENDOR_SELECTED_VERSION "@LIBTORCH_VENDOR_SELECTED_VERSION@")
set(LIBTORCH_VENDOR_VARIANT "@LIBTORCH_VENDOR_VARIANT@")
include("${libtorch_vendor_DIR}/libtorch_vendor_reuse.cmake")

# The CUDA vendor takes precedence over the CPU SDK.
if(NOT LIBTORCH_CUDA_VENDOR_ACTIVE)
  if(NOT "@LIBTORCH_VENDOR_TORCH_DIR@" STREQUAL "")
    set(Torch_DIR "@LIBTORCH_VENDOR_TORCH_DIR@")
  else()
    set(Torch_DIR "${libtorch_vendor_DIR}/../../../opt/libtorch_vendor/share/cmake/Torch")
  endif()
endif()

if(NOT LIBTORCH_VENDOR_VARIANT STREQUAL "cpu")
  include("${libtorch_vendor_DIR}/libtorch_vendor_cuda.cmake")
endif()

include("${libtorch_vendor_DIR}/libtorch_vendor_select.cmake")
